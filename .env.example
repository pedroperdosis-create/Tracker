# Telegram bot token from BotFather
BOT_TOKEN=

# Postgres connection string
DATABASE_URL=postgresql://tracker:tracker@db:5432/tracker?schema=public

# Optional TonAPI key
TONAPI_KEY=

# Optional TonAPI base
TONAPI_BASE=https://tonapi.io/v2

# Enable faster polling defaults when set to 1
FAST_MODE=0

# Polling interval for watcher (milliseconds)
POLL_INTERVAL_MS=12000

# Fast interval in ms when new events detected
FAST_POLL_INTERVAL_MS=3000

# Max backoff in ms when TonAPI errors/429 happen
MAX_POLL_BACKOFF_MS=60000

# Limit concurrent wallet requests per tick
MAX_PARALLEL_WALLETS=3

# TonAPI global rate limiter
TONAPI_RPS=2
TONAPI_BURST=2
TONAPI_CONCURRENCY=1

# Toncenter websocket mode
WS_MODE=0
TONCENTER_WS_URL=
TONCENTER_API_KEY=
